# --- Required -----------------------------------------------------------
VULAVULA_API_TOKEN=your_vulavula_token_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# --- Optional: server ---------------------------------------------------
# PORT=5050

# --- Optional: transcript post-processing --------------------------------
# Vulavula returns transcripts unpunctuated and lowercased. Before translating,
# the raw transcript is passed through Claude to restore punctuation and casing
# (it never rewords — output that drifts is rejected and the raw text is used).
# Costs one extra API round trip; set to 0 to skip it.
# PUNCTUATE_TRANSCRIPT=1
#
# claude-haiku-4-5 is ~2s faster per turn with near-identical results.
# PUNCTUATE_MODEL=claude-opus-5

# --- Optional: isiZulu text-to-speech -----------------------------------
# Claude's isiZulu reply is spoken via the OmniVoice Gradio Space (see
# TTS_NOTES.md). Nothing runs locally; all defaults below work as-is.
#
# "omnivoice" (default) calls the Space; "off" disables TTS and the pipeline
# returns text only.
# TTS_BACKEND=omnivoice
#
# Base URL of the Space. The default is the public one: it cold-starts and
# queues, so point this at your own duplicated always-on Space for a demo.
# OMNIVOICE_SPACE_URL=https://k2-fsa-omnivoice.hf.space
#
# "design" (default) = text + language only, no reference clip.
# "clone" = reproduces a reference voice; requires OMNIVOICE_REF_AUDIO and
# OMNIVOICE_REF_TEXT below.
# OMNIVOICE_MODE=design
#
# Overrides the api_name implied by OMNIVOICE_MODE (_design_fn / _clone_fn).
# OMNIVOICE_API_NAME=_design_fn
#
# Must match the Space's language dropdown label exactly.
# OMNIVOICE_LANG=Zulu
#
# Hugging Face token. STRONGLY RECOMMENDED: the public Space runs on ZeroGPU,
# and unauthenticated callers share a small per-IP quota. Once it is used up the
# Space returns a bare error and TTS silently degrades to text-only. A token
# gives you your own (larger) quota; a PRO account gets 8x that plus queue
# priority. Also required if you duplicate the Space as private.
# OMNIVOICE_TOKEN=
#
# Seconds to keep polling a cold or queued Space before giving up.
# OMNIVOICE_TIMEOUT=180
#
# Generation knobs (defaults mirror the Space's own).
# OMNIVOICE_STEPS=32
# OMNIVOICE_CFG=2.0
# OMNIVOICE_SPEED=1.0
#
# Voice-clone only: a short reference clip (URL or path) and its transcript.
# OMNIVOICE_REF_AUDIO=
# OMNIVOICE_REF_TEXT=
# OMNIVOICE_INSTRUCT=
